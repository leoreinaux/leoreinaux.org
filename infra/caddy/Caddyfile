# HTTPS automático (Let's Encrypt) para a newsletter e o analytics.
# Os domínios vêm do .env; os registros DNS precisam apontar para a VPS sem o proxy da Cloudflare
# (nuvem cinza), para o Caddy emitir o certificado e ver o IP real de quem se inscreve.
{
	email {$ACME_EMAIL}
	order rate_limit before reverse_proxy
}

(cabecalhos) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	encode zstd gzip
}

{$LISTMONK_DOMINIO} {
	import cabecalhos

	# Contra inscrições em massa: até 5 por IP a cada 10 minutos, no formulário e na API pública.
	rate_limit {
		zone inscricoes {
			match {
				method POST
				path /subscription/form /api/public/subscription
			}
			key {remote_host}
			events 5
			window 10m
		}
		# Contra força bruta na senha do painel: até 10 tentativas de login por IP a cada 10 minutos.
		zone login_listmonk {
			match {
				method POST
				path /admin/login
			}
			key {remote_host}
			events 10
			window 10m
		}
	}

	reverse_proxy listmonk:9000
}

{$UMAMI_DOMINIO} {
	import cabecalhos

	# Contra força bruta na senha do painel: até 10 tentativas de login por IP a cada 10 minutos.
	rate_limit {
		zone login_umami {
			match {
				method POST
				path /api/auth/login
			}
			key {remote_host}
			events 10
			window 10m
		}
	}

	reverse_proxy umami:3000
}
