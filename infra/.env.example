# Copie para infra/.env e preencha. O .env nunca vai para o repositório.
# Gere senhas e segredos com: openssl rand -base64 32 | tr -d '/+=' | cut -c1-32

# Domínios servidos pela VPS (registros A/AAAA apontando para ela, sem proxy da Cloudflare).
LISTMONK_DOMINIO=newsletter.leoreinaux.org
UMAMI_DOMINIO=analytics.leoreinaux.org
# E-mail para avisos do Let's Encrypt sobre os certificados.
ACME_EMAIL=

# PostgreSQL: usuário principal (também usado pelo Listmonk) e senha do banco do Umami.
POSTGRES_USER=listmonk
POSTGRES_PASSWORD=
UMAMI_DB_PASSWORD=

# Administrador do Listmonk, criado na primeira subida.
LISTMONK_ADMIN_USER=admin
LISTMONK_ADMIN_PASSWORD=

# Segredo das sessões do Umami.
UMAMI_APP_SECRET=

# Backup com restic (infra/backup.sh) num bucket S3 compatível, por exemplo o Cloudflare R2.
# Exemplo de repositório no R2: s3:https://<id-da-conta>.r2.cloudflarestorage.com/<bucket>
RESTIC_REPOSITORY=
# Senha que cifra o backup. Guarde fora da VPS: sem ela não há como restaurar.
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
