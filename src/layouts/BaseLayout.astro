---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { site } from '../../site.config';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import { OG_HEIGHT, OG_WIDTH } from '../lib/og';
import { serializeJsonLd, type JsonLdNode } from '../lib/jsonld';
import { NOVA_ABA_ID } from '../lib/links';

interface Props {
  /** Título da página; o nome do site é acrescentado, exceto na home. */
  title: string;
  /** Meta description, até 160 caracteres. */
  description: string;
  /** Caminho canônico; por padrão, o da própria página. */
  canonicalPath?: string;
  /** Card social (Open Graph, 1200×630): caminho ou URL absoluta, tipo e texto alternativo; por padrão, o card do site. */
  ogImage?: { path: string; type: 'image/png' | 'image/jpeg'; alt: string };
  /** "article" nos posts; "website" no resto. */
  ogType?: 'website' | 'article';
  /** Nós de dados estruturados da página (schema.org). */
  jsonLd?: JsonLdNode[];
  /** Pede aos buscadores para não indexar a página (por exemplo, a busca). */
  noindex?: boolean;
}

const {
  title,
  description,
  canonicalPath,
  ogImage = { path: '/og.png', type: 'image/png', alt: `${site.name}: ${site.description}` },
  ogType = 'website',
  jsonLd,
  noindex = false,
} = Astro.props;
const fullTitle = title === site.name ? title : `${title} · ${site.name}`;
const path = canonicalPath ?? Astro.url.pathname.replace(/(\/index)?\.html$/, '').replace(/(.)\/$/, '$1');
const canonical = new URL(path, site.url).href;
const ogImageUrl = new URL(ogImage.path, site.url).href;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={site.name} href={new URL('/rss.xml', site.url).href} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <!-- Pré-carrega só os estilos normais; os itálicos baixam quando usados. -->
    <Font cssVariable="--font-body" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-heading" preload={[{ style: 'normal' }]} />
    <script is:inline>
      // Aplica o tema salvo antes da primeira pintura, para não piscar.
      try {
        const tema = localStorage.getItem('tema');
        if (tema === 'light' || tema === 'dark') document.documentElement.dataset.theme = tema;
      } catch {}
    </script>
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.lang.replace('-', '_')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content={ogImage.type} />
    <meta property="og:image:width" content={String(OG_WIDTH)} />
    <meta property="og:image:height" content={String(OG_HEIGHT)} />
    <meta property="og:image:alt" content={ogImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <Analytics />
    {jsonLd && <script type="application/ld+json" is:inline set:html={serializeJsonLd(jsonLd)} />}
    <slot name="head" />
  </head>
  <body>
    <a class="pular-conteudo" href="#conteudo">Pular para o conteúdo</a>
    <Header />
    <main id="conteudo" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <!-- Aviso lido pelos leitores de tela nos links externos (aria-describedby); ver src/lib/links.ts. -->
    <span id={NOVA_ABA_ID} hidden>abre em nova aba</span>
  </body>
</html>
