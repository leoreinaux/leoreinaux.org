---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../../site.config';
import { Picture } from 'astro:assets';
import { profilePageNodes } from '../lib/jsonld';
import { authorPhoto } from '../lib/images';

const photo = authorPhoto();
---

<BaseLayout title="Sobre" description={`Quem é ${site.author.name} e o que você encontra neste site.`} jsonLd={await profilePageNodes()}>
  <div class="coluna sobre">
    <h1>Sobre</h1>
    {
      photo && (
        <Picture
          class="foto-autor"
          src={photo.src}
          formats={['avif', 'webp']}
          alt={photo.alt}
          widths={[192, 384]}
          sizes="12rem"
          loading="eager"
        />
      )
    }
    <p><strong>{site.author.name}</strong></p>
    <p>{site.author.bio}</p>

    <h2>Por que este site</h2>
    {site.author.about.map((paragrafo) => <p>{paragrafo}</p>)}
    <p>
      Por isso os textos estão sob a licença{' '}
      <a href={site.contentLicense.url} rel="license">{site.contentLicense.name}</a>: podem ser copiados e republicados com crédito.
    </p>
    <p>
      Quer fazer um site igual a este? O código é open source e se encontra em{' '}
      <a href={site.sourceCode}>{site.sourceCode.replace(/^https:\/\//, '')}</a>.
    </p>

    {
      site.social.length > 0 && (
        <>
          <h2>Onde me encontrar</h2>
          <ul>
            {site.social.map(({ label, url }) => (
              <li>
                <a href={url} rel="me">
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </>
      )
    }
  </div>
</BaseLayout>

<style>
  .sobre {
    padding-block-start: var(--space-5);
  }

  .foto-autor {
    display: block;
    inline-size: 12rem;
    block-size: auto;
    aspect-ratio: 1;
    border-radius: 50%;
    margin-block-end: var(--space-4);
  }
</style>
