---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../../site.config';
import { formatDate, getPublishedPosts, postUrl } from '../lib/posts';

const posts = await getPublishedPosts();
---

<BaseLayout title={site.name} description={site.description}>
  <div class="coluna">
    <h1 class="visualmente-oculto">{site.name}</h1>
    <p class="apresentacao">{site.description}</p>

    <section aria-labelledby="textos-titulo">
      <h2 id="textos-titulo">Textos</h2>
      {
        posts.length === 0 ? (
          <p>Ainda não há textos publicados. O primeiro vem em breve.</p>
        ) : (
          <ul class="lista-posts" role="list">
            {posts.map((post) => (
              <li>
                <article>
                  <h3>
                    <a href={postUrl(post)}>{post.data.title}</a>
                  </h3>
                  <p class="texto-secundario">
                    <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, site.locale)}</time>
                    {post.data.draft && ' · Rascunho'}
                  </p>
                  <p>{post.data.description}</p>
                </article>
              </li>
            ))}
          </ul>
        )
      }
    </section>
  </div>
</BaseLayout>

<style>
  .apresentacao {
    font-size: 1.2em;
    margin-block: var(--space-5);
  }

  .lista-posts {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lista-posts > li + li {
    margin-block-start: var(--space-5);
  }

  .lista-posts h3 {
    margin-block: 0 var(--space-1);
  }

  .lista-posts p {
    margin-block-end: var(--space-2);
  }

  .lista-posts .texto-secundario {
    font-family: var(--font-heading);
  }
</style>
