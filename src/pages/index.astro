---
import BaseLayout from '../layouts/BaseLayout.astro';
import Compartilhar from '../components/Compartilhar.astro';
import ListaPosts from '../components/ListaPosts.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { site } from '../../site.config';
import { getPublishedPosts } from '../lib/posts';
import { personNode, websiteNode } from '../lib/jsonld';

const posts = await getPublishedPosts();
---

<BaseLayout title={site.name} description={site.description} jsonLd={[websiteNode(), await personNode()]}>
  <div class="coluna">
    <h1 class="visualmente-oculto">{site.name}</h1>

    <section aria-labelledby="textos-titulo">
      <h2 id="textos-titulo">Textos</h2>
      {posts.length === 0 ? <p>Ainda não há textos publicados. O primeiro vem em breve.</p> : <ListaPosts posts={posts} nivel={3} />}
    </section>

    <Compartilhar url={new URL('/', site.url).href} title={site.name} />
    <NewsletterForm />
  </div>
</BaseLayout>
